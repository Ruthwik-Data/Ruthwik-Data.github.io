---
import { Icon } from "astro-icon/components";
import type { OpenSourceContribution } from "../types/config";

type Props = OpenSourceContribution;

const { repo, title, ref, status, url, summary } = Astro.props;
const isMerged = status === "Merged";

const statusStyles = isMerged
  ? "bg-purple-500/10 text-purple-300 border-purple-500/30"
  : "bg-blue-500/10 text-blue-300 border-blue-500/30";
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class={`block group relative p-6 bg-zinc-900/50 border rounded-3xl transition-all hover:scale-[1.03] hover:bg-zinc-900/80 hover:shadow-xl ${isMerged ? "border-purple-500/30 hover:border-purple-400/50 hover:shadow-purple-900/20" : "border-white/5 hover:border-blue-500/30 hover:shadow-blue-900/10"}`}
>
  <div class="relative z-10">
    <div class="flex items-center justify-between mb-5 gap-3">
      <div class="flex items-center gap-2 min-w-0">
        <Icon name="mdi:github" width={18} height={18} class="text-zinc-500 shrink-0" />
        <span class="text-sm text-zinc-400 font-mono truncate">{repo}</span>
      </div>
      <span class={`px-2 py-1 rounded text-[10px] font-bold uppercase tracking-widest border shrink-0 ${statusStyles}`}>
        {status}
      </span>
    </div>

    <h3 class={`text-lg font-bold text-white mb-3 leading-snug transition-colors ${isMerged ? "group-hover:text-purple-300" : "group-hover:text-blue-300"}`}>
      {title}
    </h3>
    <p class="text-sm text-zinc-400 mb-5 leading-relaxed line-clamp-3">{summary}</p>

    <div class="flex items-center justify-between">
      <span class="text-xs font-mono text-zinc-500">{ref}</span>
      <div class={`flex items-center text-xs font-bold uppercase tracking-widest gap-2 transition-colors ${isMerged ? "text-purple-400/70 group-hover:text-purple-300" : "text-blue-500/70 group-hover:text-blue-300"}`}>
        View on GitHub
        <Icon name="mdi:arrow-right" class="group-hover:translate-x-1 transition-transform" />
      </div>
    </div>
  </div>
</a>
