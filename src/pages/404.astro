---
import Layout from "../layouts/Layout.astro";
import { identity } from "../config";

const seo = {
  title: `404 — Page Not Found | ${identity.name}`,
  description: "This page doesn't exist.",
  image: identity.logo,
};
---

<Layout seo={seo}>
  <section class="max-w-4xl mx-auto px-6 min-h-[60vh] flex flex-col items-center justify-center text-center">
    <p class="text-7xl md:text-8xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-emerald-400 mb-4">404</p>
    <h1 class="text-2xl font-bold text-white mb-3">This page wandered off.</h1>
    <p class="text-zinc-400 mb-8 max-w-md">The link may be broken or the page moved. Let's get you back to the work.</p>
    <div class="flex flex-wrap gap-4 justify-center">
      <a href="/" class="px-6 py-3 bg-blue-600 hover:bg-blue-500 text-white rounded-full font-bold transition-all">Back to Home</a>
      <a href="/#projects" class="px-6 py-3 bg-zinc-800 hover:bg-zinc-700 text-white rounded-full font-bold transition-all border border-zinc-700">View Projects</a>
    </div>
  </section>
</Layout>
